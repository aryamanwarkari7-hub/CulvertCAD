@* Views/Shared/_Layout.cshtml *@
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] — CulvertCAD</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />


    <link rel="icon" href="data:,">
</head>

<body>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <div class="app-shell">


<button type="button"
        class="mobile-menu-toggle"
        id="mobile-menu-toggle"
        aria-label="Open navigation"
        aria-controls="app-sidebar"
        aria-expanded="false">
    <i class="bi bi-list" aria-hidden="true"></i>
</button>

            

            <aside class="sidebar" id="app-sidebar">

                <div class="sidebar-header">
                    <a asp-controller="Home"
                       asp-action="Index"
                       class="logo">
                        <span class="logo-glyph">◈</span>
                        <span class="logo-text">CulvertCAD</span>
                        
                    </a>
                    <button type="button"
                            class="sidebar-menu-toggle"
                            id="sidebar-menu-toggle"
                            aria-label="Toggle navigation"
                            aria-controls="app-sidebar"
                            aria-expanded="true">
                        <i class="bi bi-list" aria-hidden="true"></i>
                    </button>
                </div>

                <nav class="sidebar-nav">

                    <a asp-controller="Home"
                       asp-action="Index"
                       class="nav-item">
                        <i class="bi bi-grid-1x2 nav-icon" aria-hidden="true"></i>
                        <span>Dashboard</span>
                    </a>

                    <a asp-controller="Projects"
                       asp-action="Index"
                       class="nav-item">
                        <i class="bi bi-folder2-open nav-icon" aria-hidden="true"></i>
                        <span>Projects</span>
                    </a>

                    @if (User.IsInRole("SuperAdmin") || User.IsInRole("Admin"))
                    {
                        <a asp-controller="Account"
                           asp-action="Users"
                           class="nav-item">
                            <i class="bi bi-people nav-icon" aria-hidden="true"></i>
                            <span>Users</span>
                        </a>
                    }

                </nav>

                <div class="sidebar-footer">

                    <div class="user-chip">
                        <div class="avatar">
                            @(User.Identity?.Name?.FirstOrDefault().ToString() ?? "?")
                        </div>

                        <div class="user-meta">
                            <span class="user-name">
                                @User.FindFirst("FullName")?.Value
                            </span>
                        </div>
                    </div>

                    
                    <form asp-controller="Account"
                          asp-action="Logout"
                          method="post"
                          class="logout-form">

                        <button type="submit"
                                class="logout-btn"
                                title="Sign out"
                                aria-label="Sign out">

                            <i class="bi bi-box-arrow-right" aria-hidden="true"></i>
                            <span>Sign out</span>

                        </button>
                    </form>


                </div>

            </aside>

            <main class="main-area">

                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success" role="alert">
                        @TempData["Success"]
                    </div>
                }

                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-error" role="alert">
                        @TempData["Error"]
                    </div>
                }

                @RenderBody()

            </main>

        </div>
    }
    else
    {
        @RenderBody()
    }

    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
