@* Views/Shared/_Layout.cshtml *@
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="csrf-token" content="@Antiforgery.GetAndStoreTokens(Context).RequestToken" />

    <title>@ViewData["Title"] — Culvert Locator</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

   
    <link rel="icon" href="data:,">
</head>

<body>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <div class="app-shell">


<button type="button"
        class="mobile-menu-toggle"
        id="mobile-menu-toggle"
        aria-label="Open navigation"
        aria-controls="app-sidebar"
        aria-expanded="false">
    <i class="bi bi-list" aria-hidden="true"></i>
</button>

            

            <aside class="sidebar" id="app-sidebar">

                <div class="sidebar-header">
                    <a asp-controller="Home"
                       asp-action="Index"
                       class="logo">
                        <i class="bi bi-geo-alt-fill logo-glyph"></i>

                        <span class="logo-text">Culvert Locator</span>
                        
                    </a>
                    <button type="button"
                            class="sidebar-menu-toggle"
                            id="sidebar-menu-toggle"
                            aria-label="Toggle navigation"
                            aria-controls="app-sidebar"
                            aria-expanded="true">
                        <i class="bi bi-list" aria-hidden="true"></i>
                    </button>
                </div>

                @{
                    var currentController =
                        ViewContext.RouteData.Values["controller"]?.ToString();
                }

                <nav class="sidebar-nav">

                    <div class="nav-group-label">OVERVIEW</div>

                    <!-- Dashboard -->
                    <a asp-controller="Home"
                       asp-action="Index"
                       title="Dashboard"
                       class="nav-item @(currentController == "Home" ? "active" : "")">
                        <i class="bi bi-grid-1x2-fill nav-icon" aria-hidden="true"></i>
                        <span>Dashboard</span>
                    </a>

                    <div class="nav-group-label">  PROJECTS WORKSPACE</div>

                    <!-- Projects -->
                    <a asp-controller="Projects"
                       asp-action="Index"
                       title="Projects"
                       class="nav-item @(currentController == "Projects" ? "active" : "")">
                        <i class="bi bi-folder-fill nav-icon" aria-hidden="true"></i>
                        <span>Projects</span>
                    </a>

                    <a asp-controller="Survey"
                       asp-action="Index"
                       title="Surveys"
                       class="nav-item @(currentController == "Survey" ? "active" : "")">
                        <i class="bi bi-geo-alt-fill nav-icon" aria-hidden="true"></i>
                        <span>Surveys</span>
                    </a>

                    <div class="nav-group-label">  CAD WORKSPACE</div>
                                 
                    <!-- CAD WORKSPACE -->
                    <a asp-controller="CadDrawings"
                       asp-action="Index"
                       title="Drawings"
                       class="nav-item @(currentController == "CadDrawings" ? "active" : "")">
                        <i class="bi bi-vector-pen nav-icon" aria-hidden="true"></i>
                        <span>2D Drawing Viewer</span>
                    </a>

                    <a asp-controller="CadSolidViewer"
                       asp-action="Index"
                       title="Solid Viewer"
                       class="nav-item @(currentController == "CadSolidViewer" ? "active" : "")">
                        <i class="bi bi-box nav-icon" aria-hidden="true"></i>
                        <span>3D Solid Viewer</span>
                    </a>

                    <!-- Admin -->
                    @if (User.IsInRole("SuperAdmin") || User.IsInRole("Admin"))
                    {
                        <div class="nav-group-label">ADMINISTRATION</div>

                        <a asp-controller="Account"
                           asp-action="Users"
                           title="Users"
                           class="nav-item @(currentController == "Account" ? "active" : "")">
                            <i class="bi bi-people-fill nav-icon" aria-hidden="true"></i>
                            <span>Users</span>
                        </a>
                    }

                </nav>

                <div class="sidebar-footer">

                    <div class="user-chip">
                        <div class="avatar">
                            @{
                                var displayName = User.FindFirst("FullName")?.Value
                                                  ?? User.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value
                                                  ?? User.Identity?.Name
                                                  ?? "User";
                                // Get first letter for avatar, fallback to 'U'
                                var initial = !string.IsNullOrEmpty(displayName) ? char.ToUpper(displayName[0]) : 'U';
                            }
                            @initial
                        </div>

                        <div class="user-meta">
                            <span class="user-name" title="@displayName">
                                @displayName
                            </span>
                        </div>
                    </div>

                    
                    <form asp-controller="Account"
                          asp-action="Logout"
                          method="post"
                          class="logout-form">

                        <button type="submit"
                                class="logout-btn"
                                title="Sign out"
                                aria-label="Sign out">

                            <i class="bi bi-box-arrow-right" aria-hidden="true"></i>
                            <span>Sign out</span>

                        </button>
                    </form>


                </div>

            </aside>

            <main class="main-area">

                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success" role="alert">
                        @TempData["Success"]
                    </div>
                }

                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-error" role="alert">
                        @TempData["Error"]
                    </div>
                }

                @RenderBody()

            </main>

        </div>
    }
    else
    {
        @RenderBody()
    }

    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
