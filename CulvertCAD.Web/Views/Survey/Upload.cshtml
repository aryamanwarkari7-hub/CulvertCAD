@{
    ViewData["Title"] = "Project Survey Analysis";
    ViewData["PageTitle"] = "Project Survey Analysis";
    ViewData["PageSubtitle"] =
        "Upload the survey data and prescribed road alignment to prepare the project for combined analysis.";

    ViewData["PageHeaderBreadcrumbs"] = new List<Dictionary<string, string>>
    {
        new()
        {
            ["Text"] = ViewBag.ProjectName?.ToString() ?? "Project",
            ["Url"] = Url.Action(
                "Details",
                "Projects",
                new { id = ViewBag.ProjectId }) ?? "#"
        },
        new()
        {
            ["Text"] = "Survey Analysis",
            ["Url"] = ""
        }
    };
}

<div class="page">
    <partial name="_PageHeader" />

    <div class="survey-upload-layout">

        <div class="card survey-upload-card">

            <div asp-validation-summary="All"
                 class="alert-error survey-validation-summary"
                 role="alert"></div>

        @if (TempData["Error"] != null)
        {
            <div class="alert-error" role="alert">
                @TempData["Error"]
            </div>
        }

        <form asp-controller="Survey"
              asp-action="UploadAndAnalyze"
              asp-route-projectId="@ViewBag.ProjectId"
              method="post"
              enctype="multipart/form-data">

            @Html.AntiForgeryToken()

            <div class="survey-upload-section-header">
                <span class="survey-upload-step">01</span>
                <div>
                    <h2>Survey Data</h2>
                    <p>Upload survey coordinates and configure their coordinate system.</p>
                </div>
            </div>

            <div class="fg">
                <label for="csvFile">Survey CSV File *</label>

                <input type="file"
                       id="csvFile"
                       name="csvFile"
                       accept=".csv"
                       class="fi"
                       required />

                <small>
                    Include point number, coordinates, elevation
                    and feature code.
                </small>
            </div>

           
            <div class="fg survey-coordinate-field">
                <label class="survey-coordinate-label">
                    Coordinate Type <span class="required-mark">*</span>
                </label>

                <div class="survey-coordinate-options">
                    <label class="survey-coordinate-option" for="coordinateLatLong">
                        <input type="radio"
                               name="coordinateType"
                               value="LatitudeLongitude"
                               id="coordinateLatLong" />
                        <span>
                            <strong>Latitude / Longitude</strong>
                            <small>Geographic coordinates in degrees</small>
                        </span>
                    </label>

                    <label class="survey-coordinate-option" for="coordinateGrid">
                        <input type="radio"
                               name="coordinateType"
                               value="EastingNorthing"
                               id="coordinateGrid"
                               checked />
                        <span>
                            <strong>Easting / Northing</strong>
                            <small>Projected grid coordinates in metres</small>
                        </span>
                    </label>
                </div>
            </div>


            <div id="utmSettings"
                 class="fg"
                 style="margin-top:1.25rem">

                <label for="utmZone">UTM Zone *</label>

                <select id="utmZone"
                        name="utmZone"
                        class="fi">
                    <option value="42">Zone 42N</option>
                    <option value="43" selected>Zone 43N</option>
                    <option value="44">Zone 44N</option>
                    <option value="45">Zone 45N</option>
                    <option value="46">Zone 46N</option>
                    <option value="47">Zone 47N</option>
                </select>
            </div>

            <hr style="margin:1.5rem 0" />

            
            <div class="survey-upload-section-header">
                <span class="survey-upload-step">02</span>
                <div>
                    <h2>Prescribed Road Alignment</h2>
                    <p>Upload the existing road centreline drawing and specify its source CRS.</p>
                </div>
            </div>


            <p>
                Upload the existing road alignment DXF.
                The system will use the specified centreline;
                it will not generate or optimize the road.
            </p>

            <div class="fg">
                <label for="dxfFile">Road Alignment DXF File *</label>

                <input type="file"
                       id="dxfFile"
                       name="dxfFile"
                       accept=".dxf"
                       class="fi"
                       required />
            </div>

            <div class="fg" style="margin-top:1rem">
                <label for="centrelineHandle">Centreline Handle</label>

                <input type="text"
                       id="centrelineHandle"
                       name="centrelineHandle"
                       class="fi"
                       value="4E2F"
                       readonly />
            </div>

            <div class="fg" style="margin-top:1rem">
                <label for="dxfInputCrs">DXF Source Coordinate System *</label>

                <select id="dxfInputCrs"
                        name="dxfInputCrs"
                        class="fi"
                        required>
                    <option value="">Select the DXF source CRS</option>
                    <option value="EPSG:32642">WGS 84 / UTM Zone 42N</option>
                    <option value="EPSG:32643">WGS 84 / UTM Zone 43N</option>
                    <option value="EPSG:32644">WGS 84 / UTM Zone 44N</option>
                    <option value="EPSG:32645">WGS 84 / UTM Zone 45N</option>
                    <option value="EPSG:32646">WGS 84 / UTM Zone 46N</option>
                    <option value="EPSG:32647">WGS 84 / UTM Zone 47N</option>
                </select>

                <small>
                    Select the actual CRS used by the DXF drawing, not merely
                    the zone selected for the survey.
                </small>
            </div>

            <div class="info-pill" style="margin-top:1rem">
                Both files are required for this combined analysis request.
            </div>

            
            <div class="survey-upload-actions">
                <a asp-controller="Projects"
                   asp-action="Details"
                   asp-route-id="@ViewBag.ProjectId"
                   class="btn-ghost">
                    <i class="bi bi-arrow-left" aria-hidden="true"></i>
                    <span>Cancel</span>
                </a>

                <button type="submit" class="btn-primary">
                    <i class="bi bi-cloud-arrow-up" aria-hidden="true"></i>
                    <span>Upload Files &amp; Analyze</span>
                </button>
            </div>

        </form>
    </div>
        <aside class="card survey-project-summary">
            <div class="survey-project-summary-header">
                <i class="bi bi-folder2-open" aria-hidden="true"></i>
                <h2>Project Details</h2>
            </div>

            <div class="survey-project-summary-body">
                <span class="survey-summary-label">Project Name</span>
                <p class="survey-summary-value">
                    @(ViewBag.ProjectName?.ToString() ?? "Project")
                </p>

                <div class="survey-summary-divider"></div>

                <span class="survey-summary-label">Survey Requirements</span>
                <ul class="survey-requirements">
                    <li class="survey-file-status" id="surveyCsvStatus">
                        <i class="bi bi-filetype-csv" aria-hidden="true"></i>
                        <div class="survey-file-info">
                            <strong>Survey CSV</strong>
                            <span id="surveyCsvFileName">No file selected</span>
                            <small id="surveyCsvFileSize"></small>
                        </div>
                    </li>

                    <li class="survey-file-status" id="surveyDxfStatus">
                        <i class="bi bi-file-earmark-richtext" aria-hidden="true"></i>
                        <div class="survey-file-info">
                            <strong>Road alignment DXF</strong>
                            <span id="surveyDxfFileName">No file selected</span>
                            <small id="surveyDxfFileSize"></small>
                        </div>
                    </li>

                    <li>
                        <i class="bi bi-globe" aria-hidden="true"></i>
                        <span>Coordinate system and source CRS must be correct.</span>
                    </li>
                </ul>


                <div class="survey-summary-note">
                    <i class="bi bi-info-circle" aria-hidden="true"></i>
                    Both files are required before analysis can begin.
                </div>
            </div>
        </aside>
    </div>
</div>

<script>
    (() => {
        const latLong = document.getElementById("coordinateLatLong");
        const grid = document.getElementById("coordinateGrid");
        const utmSettings = document.getElementById("utmSettings");
        const utmZone = document.getElementById("utmZone");

        function updateCoordinateOptions() {
            const isGrid = grid.checked;

            utmSettings.style.display = isGrid ? "" : "none";
            utmZone.required = isGrid;
            utmZone.disabled = !isGrid;
        }

        latLong.addEventListener("change", updateCoordinateOptions);
        grid.addEventListener("change", updateCoordinateOptions);

        updateCoordinateOptions();
    })();


    
    function formatFileSize(bytes) {
        if (bytes < 1024) return `${bytes} B`;
        if (bytes < 1024 * 1024) {
            return `${(bytes / 1024).toFixed(1)} KB`;
        }
        return `${(bytes / (1024 * 1024)).toFixed(2)} MB`;
    }

    function updateSelectedFile(inputId, nameId, sizeId, statusId) {
        const input = document.getElementById(inputId);
        const name = document.getElementById(nameId);
        const size = document.getElementById(sizeId);
        const status = document.getElementById(statusId);

        if (!input || !name || !size || !status) return;

        const file = input.files?.[0];

        name.textContent = file ? file.name : "No file selected";
        size.textContent = file ? formatFileSize(file.size) : "";

        status.classList.toggle("has-file", !!file);
    }

    document.getElementById("csvFile").addEventListener("change", () => {
        updateSelectedFile(
            "csvFile",
            "surveyCsvFileName",
            "surveyCsvFileSize",
            "surveyCsvStatus"
        );
    });

    document.getElementById("dxfFile").addEventListener("change", () => {
        updateSelectedFile(
            "dxfFile",
            "surveyDxfFileName",
            "surveyDxfFileSize",
            "surveyDxfStatus"
        );
    });

</script>
