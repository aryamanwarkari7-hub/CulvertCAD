@* Views/Survey/Review.cshtml *@

@using System.Text.Json
@using CulvertCAD.Core.DTOs
@using CulvertCAD.Core.Entities

@model SurveyDocument

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />


@{
    ViewData["Title"] = "Survey Analysis";

    ViewData["PageTitle"] = "Survey Analysis";
    ViewData["PageSubtitle"] = Model.FileName;
    ViewData["PageRegion"] = null;

    ViewData["PageHeaderBreadcrumbs"] =
        new List<Dictionary<string, string>>
        {
            new()
            {
                ["Text"] = "Projects",
                ["Url"] = Url.Action("Index", "Projects")!
            },
            new()
            {
                ["Text"] = ViewBag.ProjectName?.ToString() ?? "Project",
                ["Url"] = Url.Action(
                    "Details",
                    "Projects",
                    new { id = ViewBag.ProjectId })!
            },
            new()
            {
                ["Text"] = "Survey Analysis"
            }
        };

    ViewData["PageHeaderActions"] =
        new List<Dictionary<string, string>>();

    var summary = ViewBag.Summary as SurveySummaryDto;
    var locations = ViewBag.Locations as List<DetectedCulvertLocation> ?? new();
    var tbms = ViewBag.TBMs as List<TBMPoint> ?? new();

    // Survey map data
    var surveyMapPointsJson = JsonSerializer.Serialize(ViewBag.SurveyMapPoints);
    var surveyMapAlignmentJson = JsonSerializer.Serialize(ViewBag.SurveyMapAlignment);
    var surveyMapCulvertsJson = JsonSerializer.Serialize(ViewBag.SurveyMapCulverts);
}

<div class="page">
    <partial name="_PageHeader" />

    <p class="page-sub survey-upload-info">
        Uploaded @Model.UploadedAt.ToString("dd MMM yyyy HH:mm")
    </p>

    <div class="stat-grid">

    <div class="stat-card">
        <div class="stat-icon" style="background:#58a6ff22;color:#58a6ff">
            <i class="bi bi-geo-alt-fill"></i>
        </div>
        <div class="stat-body">
            <div class="stat-val">@summary?.TotalPoints</div>
            <div class="stat-lbl">Total Points</div>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-icon" style="background:#f0883e22;color:#f0883e">
            <i class="bi bi-rulers"></i>
        </div>
        <div class="stat-body">
            <div class="stat-val">@((summary?.AlignmentLengthM / 1000)?.ToString("0.00"))km</div>
            <div class="stat-lbl">Alignment Length</div>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-icon" style="background:#3fb95022;color:#3fb950">
            <i class="bi bi-water"></i>
        </div>
        <div class="stat-body">
            <div class="stat-val">@summary?.DetectedCulverts</div>
            <div class="stat-lbl">Detected Culverts</div>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-icon" style="background:#d2992222;color:#d29922">
            <i class="bi bi-triangle"></i>
        </div>
        <div class="stat-body">
            <div class="stat-val">@summary?.TBMCount</div>
            <div class="stat-lbl">TBMs</div>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-icon" style="background:#bc8cff22;color:#bc8cff">
            <i class="bi bi-building"></i>
        </div>
        <div class="stat-body">
            <div class="stat-val">@summary?.BridgePoints</div>
            <div class="stat-lbl">Bridge Points</div>
        </div>
    </div>
    </div>


    <!-- Survey Terrain Map -->
    <!-- Survey Terrain Map -->
    <div class="card survey-map-card">

        <div class="survey-map-header">
            <div>
                <h3>Survey Terrain &amp; Drainage Map</h3>
                <p>
                    Visualise surveyed elevations, road alignment and
                    detected culvert locations.
                </p>
            </div>
            <!-- Compact Header Badges for Survey Stats -->
            <div class="survey-map-summary">
                <div class="survey-map-summary-item">
                    <span class="survey-map-summary-label">Survey Points</span>
                    <strong id="survey-map-point-count">0</strong>
                </div>
                <div class="survey-map-summary-item">
                    <span class="survey-map-summary-label">Alignment Points</span>
                    <strong id="survey-map-alignment-count">0</strong>
                </div>
                <div class="survey-map-summary-item">
                    <span class="survey-map-summary-label">Culvert Groups</span>
                    <strong id="survey-map-culvert-count">0</strong>
                </div>
            </div>
        </div>

        <div class="survey-map-body">

            <div id="survey-map-container">
                <div id="survey-leaflet-map"></div>
                <canvas id="survey-map-canvas"></canvas>

                <!-- Floating CAD Navigation Pill Bar (Top-Left) -->
                <div class="survey-cad-nav-strip">
                    <button type="button" id="survey-map-recenter" class="cad-nav-btn primary" title="Recenter View">
                        <i class="bi bi-arrows-fullscreen"></i> <span>Recenter</span>
                    </button>
                    <div class="cad-nav-divider"></div>
                    <button type="button" id="survey-map-top-view" class="cad-nav-btn" title="Top View (2D Plan)">
                        <i class="bi bi-map"></i> <span>Top</span>
                    </button>
                    <button type="button" id="survey-map-3d-view" class="cad-nav-btn" title="Isometric 3D View">
                        <i class="bi bi-box"></i> <span>3D</span>
                    </button>
                    <button type="button" id="survey-map-north-up" class="cad-nav-btn" title="Orient North Up">
                        <i class="bi bi-compass"></i> <span>North</span>
                    </button>
                    <div class="cad-nav-divider"></div>
                    <button type="button" id="survey-map-fullscreen" class="cad-nav-btn" title="Expand / Maximize Map">
                        <i class="bi bi-arrows-angle-expand"></i>
                    </button>
                    <button type="button" id="survey-cad-layers-toggle" class="cad-nav-btn" title="Toggle Layers Panel">
                        <i class="bi bi-layers-half"></i> <span>Layers</span>
                    </button>
                </div>

                <!-- Floating CAD Layers Drawer (Top-Right) -->
                <div id="survey-cad-layers-drawer" class="survey-cad-layers-drawer">
                    <div class="cad-layers-header">
                        <span><i class="bi bi-stack"></i> Map Layers</span>
                        <button type="button" id="survey-cad-layers-close" class="cad-layers-close-btn" title="Close">
                            <i class="bi bi-x-lg"></i>
                        </button>
                    </div>

                    <!-- Accordion Group 1: Terrain & Road -->
                    <div class="cad-layers-accordion-group">
                        <button type="button" class="cad-layers-group-toggle" data-target="cad-group-terrain">
                            <span><i class="bi bi-chevron-down cad-accordion-arrow"></i> Terrain &amp; Road</span>
                            <span class="cad-group-badge">4</span>
                        </button>
                        <div id="cad-group-terrain" class="cad-layers-list">
                            <button type="button" id="survey-map-toggle-terrain" class="cad-layer-row" aria-pressed="true">
                                <i class="bi bi-layers"></i> Terrain: On
                            </button>
                            <button type="button" id="survey-map-toggle-alignment" class="cad-layer-row" aria-pressed="true">
                                <i class="bi bi-signpost-split"></i> Alignment: On
                            </button>
                            <button type="button" id="survey-map-toggle-survey" class="cad-layer-row" aria-pressed="true">
                                <i class="bi bi-geo"></i> Survey Data: On
                            </button>
                            <button type="button" id="survey-map-toggle-culvert-solids" class="cad-layer-row" aria-pressed="true">
                                <i class="bi bi-box"></i> 3D Culvert: On
                            </button>
                        </div>
                    </div>

                    <!-- Accordion Group 2: Diagnostic Sheets -->
                    <div class="cad-layers-accordion-group">
                        <button type="button" class="cad-layers-group-toggle" data-target="cad-group-sheets">
                            <span><i class="bi bi-chevron-right cad-accordion-arrow"></i> Diagnostic Sheets</span>
                            <span class="cad-group-badge">4</span>
                        </button>
                        <div id="cad-group-sheets" class="cad-layers-list cad-group-collapsed">
                            <button type="button" id="survey-map-toggle-ground-sheet" class="cad-layer-row" aria-pressed="true">
                                <i class="bi bi-square"></i> Ground Sheet: On
                            </button>
                            <button type="button" id="survey-map-toggle-datum" class="cad-layer-row" aria-pressed="true">
                                <i class="bi bi-layers"></i> Datum Sheet: On
                            </button>
                            <button type="button" id="survey-map-toggle-cyan-terrain" class="cad-layer-row" aria-pressed="false">
                                <i class="bi bi-layers"></i> Cyan Terrain: On
                            </button>
                            <button type="button" id="survey-map-toggle-rejected-lines" class="cad-layer-row" aria-pressed="true">
                                <i class="bi bi-diagram-3"></i> Cyan Lines: On
                            </button>
                        </div>
                    </div>
                </div>

                <div id="selected-survey-point" class="selected-survey-point" hidden>
                    <div class="selected-survey-point-header">
                        <h4>Selected Survey Point</h4>
                        <button type="button"
                                id="clear-survey-point"
                                class="btn-ghost"
                                aria-label="Clear selected survey point"
                                title="Clear selection">
                            <i class="bi bi-x-lg"></i>
                        </button>
                    </div>

                    <div class="selected-survey-point-grid">
                        <div class="selected-survey-field">
                            <span>Point No.</span>
                            <strong id="selected-point-no">â€”</strong>
                        </div>
                        <div class="selected-survey-field">
                            <span>Northing</span>
                            <strong id="selected-point-northing">â€”</strong>
                        </div>
                        <div class="selected-survey-field">
                            <span>Easting</span>
                            <strong id="selected-point-easting">â€”</strong>
                        </div>
                        <div class="selected-survey-field">
                            <span>RL (m)</span>
                            <strong id="selected-point-rl">â€”</strong>
                        </div>
                        <div class="selected-survey-field">
                            <span>Code</span>
                            <strong id="selected-point-code">â€”</strong>
                        </div>
                    </div>
                </div>
            </div>

            <div class="survey-map-legend">
                <div class="survey-map-legend-item">
                    <span class="survey-map-legend-dot survey-point-dot"></span>
                    <span>Survey points</span>
                </div>

                <div class="survey-map-legend-item">
                    <span class="survey-map-legend-line alignment-line"></span>
                    <span>Road alignment</span>
                </div>



                <div class="survey-map-legend-item">
                    <span class="survey-map-legend-dot culvert-point-dot"></span>
                    <span>Detected culvert locations</span>
                </div>

                <div class="survey-map-legend-item">
                    <span class="survey-map-legend-dot terrain-point-dot"></span>
                    <span>Inferred terrain</span>
                </div>
            </div>

            <div class="survey-datum-summary">
                <div class="survey-datum-header">
                    <strong>Road Elevation vs Datum</strong>
                    <span>Datum RL: <strong id="survey-datum-rl">â€”</strong> m</span>
                </div>

                <div class="survey-datum-stats-row">

                    <div class="survey-datum-extremes">
                        <span>
                            Maximum difference:
                            <strong id="survey-datum-max-difference">â€”</strong> m
                        </span>
                    </div>

                    <div class="survey-datum-legend">
                        <div class="survey-datum-item">
                            <span class="survey-datum-swatch above"></span>
                            <span>Above datum</span>
                            <strong id="survey-datum-above-count">â€”</strong>
                        </div>

                        <div class="survey-datum-item">
                            <span class="survey-datum-swatch below"></span>
                            <span>Below datum</span>
                            <strong id="survey-datum-below-count">â€”</strong>
                        </div>

                        <div class="survey-datum-item">
                            <span class="survey-datum-swatch near"></span>
                            <span>Near datum (Â±0.10 m)</span>
                            <strong id="survey-datum-near-count">â€”</strong>
                        </div>
                    </div>

                    <div class="survey-datum-extremes">
                        <span>
                            Minimum difference:
                            <strong id="survey-datum-min-difference">â€”</strong> m
                        </span>
                    </div>

                </div>

                <p class="survey-datum-note">
                    Road elevations without an imported Existing RL may be estimated
                    from nearby survey points. These estimates are not surveyed road levels.
                </p>
            </div>


            <div id="survey-map-status" role="status" aria-live="polite">
                Preparing survey map...
            </div>

            <p class="survey-map-note">
                Survey elevations represent observed data.
                Interpolated terrain and inferred drainage features,
                when available, will be identified separately.
            </p>

        </div>
    </div>


    <script id="survey-map-points-data" type="application/json">
            @Html.Raw(surveyMapPointsJson)
    </script>

    <script id="survey-map-working-crs-data" type="application/json">
            @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.WorkingCrs))
    </script>

    <script id="survey-map-alignment-data" type="application/json">
            @Html.Raw(surveyMapAlignmentJson ?? "null")
    </script>

    <script id="survey-map-culverts-data" type="application/json">
            @Html.Raw(surveyMapCulvertsJson)
    </script>






    <div class="card">
        <div class="card-hd"><h3>Detected Culvert Locations</h3><span class="badge badge-gray">@locations.Count locations</span></div>
        <table class="dt">
            <thead><tr><th>#</th><th>Chainage</th><th>Invert RL</th><th>Road RL</th><th>Fill H</th><th>Bed Slope</th><th>Survey Pts</th><th>Status</th><th></th></tr></thead>
            <tbody>
            @foreach (var loc in locations)
            {
                int chKm = (int)(loc.Chainage / 1000); int chM = (int)(loc.Chainage % 1000);
                <tr>
                    <td>@loc.LocationIndex</td>
                    <td><code>@chKm+@chM.ToString("D3")</code></td>
                    <td>@loc.InvertRL.ToString("0.000")</td>
                    <td>@loc.RoadRL.ToString("0.000")</td>
                    <td>@loc.FillHeightM.ToString("0.000")</td>
                        <td>
                            @if (loc.BedSlopePct.HasValue)
                            {
                                @loc.BedSlopePct.Value.ToString("0.000")
                                <text>%</text>

                                @if (loc.BedSlopePct.Value < 0.2)
                                {
                                    <span class="badge badge-yellow badge-xs">flat</span>
                                }
                            }
                            else
                            {
                                <span>N/A</span>
                            }
                        </td>
                    <td>@loc.SurveyPointCount</td>
                        <td>
                            @if (loc.IsConfirmed)
                            {
                                <span class="badge badge-blue">Confirmed</span>
                            }
                            else
                            {
                                <span class="badge badge-gray">Pending</span>
                            }
                        </td>

                </tr>
            }
            </tbody>
        </table>
    </div>

    <div class="card mt-6">
        <div class="card-hd"><h3>Temporary Benchmarks (TBM)</h3></div>
        <table class="dt">
            <thead><tr><th>Name</th><th>RL (m)</th><th>Chainage</th></tr></thead>
            <tbody>
            @foreach (var t in tbms)
            {
                int chKm = (int)((t.Chainage ?? 0) / 1000); int chM = (int)((t.Chainage ?? 0) % 1000);
                <tr><td>@t.Name</td><td>@t.RL.ToString("0.000")</td><td><code>@chKm+@chM.ToString("D3")</code></td></tr>
            }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {

    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script src="~/lib/three/three.min.js"></script>
    <script src="~/lib/three/OrbitControls.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/proj4js/2.9.2/proj4.js"></script>

    <script src="~/lib/delaunator/delaunator.min.js"></script>
    <script>
        console.log("Delaunator loaded:", typeof Delaunator);
    </script>

    <script src="~/js/survey/culvert-sample-solid.js" asp-append-version="true"></script>
    <script src="~/js/survey/survey-map.js" asp-append-version="true"></script>
}
