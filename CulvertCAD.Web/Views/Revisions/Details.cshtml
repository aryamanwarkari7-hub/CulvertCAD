@* Views/Revisions/Details.cshtml *@
@model CulvertCAD.Core.DTOs.RevisionDto
@{ ViewData["Title"] = $"Revision {Model.RevisionNumber}"; }

<div class="page">
    <div class="page-header">
        <div>
            <div class="breadcrumb"><a asp-controller="Designs" asp-action="Details" asp-route-id="@ViewBag.DesignId">Design</a> / @Model.RevisionNumber</div>
            <h1 class="page-title">Revision @Model.RevisionNumber</h1>
            <p class="page-sub">@Model.RevisionPurpose · @Model.RevisionDate.ToString("dd MMM yyyy")</p>
        </div>
        <div class="action-row">
            @if (Model.Status == "Draft")
            {
                <button onclick="openAction('Submit','Submit for Review')" class="btn-primary">↑ Submit for Review</button>
            }
            @if (Model.Status == "Submitted" && (User.IsInRole("SuperAdmin") || User.IsInRole("Admin") || User.IsInRole("CheckingEngineer")))
            {
                <button onclick="openAction('StartReview','Start Review')" class="btn-primary">🔍 Start Review</button>
            }
            @if (Model.Status == "UnderReview")
            {
                @if (User.IsInRole("SuperAdmin") || User.IsInRole("Admin") || User.IsInRole("CheckingEngineer"))
                {
                    <button onclick="openAction('RequestChanges','Request Changes')" class="btn-warn">↩ Request Changes</button>
                }
                @if (User.IsInRole("SuperAdmin") || User.IsInRole("Admin"))
                {
                    <button onclick="openAction('Approve','Approve Revision')" class="btn-success">✓ Approve</button>
                }
            }
            <a asp-controller="Drawings" asp-action="Viewer" asp-route-revisionId="@Model.Id" class="btn-ghost">🎨 3D Viewer</a>
            <a asp-controller="BOQ" asp-action="Generate" asp-route-revisionId="@Model.Id" class="btn-ghost">📋 BOQ</a>
        </div>
    </div>

    <div class="status-banner" style="border-left:4px solid @RevColor(Model.Status)">
        <div class="sb-left">
            <span class="sb-pill" style="background:@RevColor(Model.Status)">@Model.Status</span>
            <span class="sb-desc">Rev. @Model.RevisionCode — @Model.ChangeDescription</span>
            @if (Model.IsLocked) { <span class="badge badge-green">🔒 Locked</span> }
        </div>
        <div class="sb-sigs">
            <div class="sig-block"><span class="sig-lbl">Prepared</span><span class="sig-name">@Model.CreatedByName</span><span class="sig-dt">@Model.CreatedAt.ToString("dd MMM yyyy")</span></div>
            @if (!string.IsNullOrEmpty(Model.CheckedByName)) { <div class="sig-block"><span class="sig-lbl">Checked</span><span class="sig-name">@Model.CheckedByName</span></div> }
            @if (!string.IsNullOrEmpty(Model.ApprovedByName)) { <div class="sig-block"><span class="sig-lbl">Approved</span><span class="sig-name">@Model.ApprovedByName</span><span class="sig-dt">@Model.ApprovedAt?.ToString("dd MMM yyyy")</span></div> }
        </div>
    </div>

    <div class="rd-grid">
        @if (Model.Result != null)
        {
            <div class="card">
                <div class="card-hd"><h3>Calculation Sheet</h3></div>
                <div class="calc-sheet">
                    <div class="cs-sect">
                        <div class="cs-hd"><span>Hydraulic Design — Manning's Equation (IS 783)</span>
                            <span class="@(Model.Result.HydraulicAdequate ? "chk-ok" : "chk-fail")">@(Model.Result.HydraulicAdequate ? "✓ OK" : "✗ FAIL")</span></div>
                        @foreach (var s in Model.Result.HydraulicSteps)
                        {
                            <div class="rr"><span>@s.Label <small>(@s.Clause)</small></span><strong>@s.Result @s.Unit</strong></div>
                        }
                    </div>
                    <div class="cs-sect">
                        <div class="cs-hd"><span>Structural Design — IS 783:1985 Cl.5</span>
                            <span class="@(Model.Result.StructuralAdequate ? "chk-ok" : "chk-fail")">@(Model.Result.StructuralAdequate ? "✓ OK" : "✗ FAIL")</span></div>
                        @foreach (var s in Model.Result.StructuralSteps)
                        {
                            <div class="rr"><span>@s.Label <small>(@s.Clause)</small></span><strong>@s.Result @s.Unit</strong></div>
                        }
                        <div class="rr"><span>Selected Pipe (IS 458)</span><strong>@Model.Result.SelectedPipeClass</strong></div>
                        <div class="rr @(Model.Result.FactorOfSafety >= 1.5 ? "rr-ok" : "rr-fail")"><span>Factor of Safety</span><strong>@Model.Result.FactorOfSafety.ToString("0.000")</strong></div>
                    </div>
                    <div class="cs-verdict @(Model.Result.IsDesignSatisfactory ? "cv-ok" : "cv-fail")">
                        @(Model.Result.IsDesignSatisfactory ? "✓ DESIGN IS SATISFACTORY" : "✗ DESIGN IS INADEQUATE — REVISION REQUIRED")
                    </div>
                </div>
            </div>
        }

        <div class="card">
            <div class="card-hd"><h3>Workflow History</h3></div>
            <div class="wf-timeline">
                @foreach (var h in Model.StatusHistory)
                {
                    <div class="wft-item">
                        <div class="wft-dot" style="background:@RevColor(h.ToStatus)"></div>
                        <div class="wft-body">
                            <div class="wft-hd"><strong>@h.ToStatus</strong><span class="wft-dt">@h.ChangedAt.ToString("dd MMM yyyy HH:mm")</span></div>
                            <div class="wft-by">by @h.ChangedByName</div>
                            @if (!string.IsNullOrEmpty(h.Remarks)) { <div class="wft-rem">"@h.Remarks"</div> }
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="card mt-6">
        <div class="card-hd"><h3>Review Comments</h3></div>
        <div class="comments">
            @foreach (var c in Model.Comments)
            {
                <div class="cmt">
                    <div class="cmt-av">@c.AuthorName.FirstOrDefault()</div>
                    <div class="cmt-body">
                        <div class="cmt-hd"><strong>@c.AuthorName</strong>
                            <span class="badge badge-xs @(c.Status == "Resolved" ? "badge-green" : "badge-yellow")">@c.Status</span>
                            <span class="cmt-dt">@c.CreatedAt.ToString("dd MMM yyyy")</span></div>
                        <p class="cmt-txt">@c.CommentText</p>
                        @if (c.Status != "Resolved")
                        {
                            <form asp-action="ResolveComment" method="post" style="display:inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="commentId" value="@c.Id" />
                                <input type="hidden" name="revisionId" value="@Model.Id" />
                                <button type="submit" class="btn-xs">Mark Resolved</button>
                            </form>
                        }
                    </div>
                </div>
            }
            @if (!Model.IsLocked)
            {
                <form asp-action="AddComment" method="post" class="cmt-form">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    <div class="cmt-av">@(User.Identity?.Name?.FirstOrDefault().ToString() ?? "?")</div>
                    <div class="cmt-input-row">
                        <input type="text" name="commentText" class="fi" placeholder="Add a comment or review note..." />
                        <button type="submit" class="btn-primary">Post</button>
                    </div>
                </form>
            }
        </div>
    </div>
</div>

<div id="actionModal" class="modal-bg" style="display:none">
    <div class="modal modal-sm">
        <div class="modal-hd"><h3 id="actionTitle"></h3><button onclick="document.getElementById('actionModal').style.display='none'">✕</button></div>
        <form id="actionForm" method="post" class="modal-body">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.Id" />
            <div class="fg"><label>Remarks</label><textarea name="remarks" class="fi ta" rows="3"></textarea></div>
            <div class="modal-actions">
                <button type="button" class="btn-ghost" onclick="document.getElementById('actionModal').style.display='none'">Cancel</button>
                <button type="submit" class="btn-primary">Confirm</button>
            </div>
        </form>
    </div>
</div>

<script>
function openAction(action, title) {
    document.getElementById('actionTitle').innerText = title;
    document.getElementById('actionForm').action = '/Revisions/' + action;
    document.getElementById('actionModal').style.display = 'flex';
}
</script>

@functions {
    string RevColor(string s) => s switch { "Approved"=>"#3fb950","Submitted"=>"#d29922","UnderReview"=>"#58a6ff","RevisionRequired"=>"#f85149",_=>"#6b7280" };
}
