
@{
    ViewData["Title"] = "CAD Drawing Viewer";
    ViewData["PageTitle"] = "CAD Drawing Viewer";
    ViewData["PageSubtitle"] =
        "Import and inspect CAD drawings before survey-map integration.";
    ViewData["PageRegion"] = null;
    ViewData["PageHeaderBreadcrumbs"] =
        new List<Dictionary<string, string>>
        {
            new()
            {
                ["Text"] = "CAD Drawing Viewer"
            }
        };
    ViewData["PageHeaderActions"] =
        new List<Dictionary<string, string>>
        {
            new()
            {
                ["Text"] = "Recent Drawings",
                ["Url"] = "javascript:void(0)",
                ["Id"] = "btnOpenHistory",
                ["CssClass"] = "btn-primary",
                ["Icon"] = "bi bi-clock-history"
            }
        };
}

<!-- Include History Drawer Styles -->
<link rel="stylesheet" href="~/css/pages/cad-solid-viewer.css" asp-append-version="true" />

<div class="page cad-drawing-page">
    <partial name="_PageHeader" />

   
<div class="cad-import-controls" style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px; margin-bottom: 12px;">
    <div style="display: flex; align-items: center; gap: 10px;">
        <input id="cadFile"
               type="file"
               accept=".dxf"
               aria-label="Select DXF file" />

        <button id="loadCad" type="button" class="btn btn-primary">
            <i class="bi bi-file-earmark-arrow-up"></i> Import DXF
        </button>
    </div>

    <!-- TARGET PROJECT SELECTOR -->
    <div class="cad-project-selector" style="display: flex; align-items: center; gap: 8px;">
        <label for="cadActiveProjectId" style="color: #8b949e; font-size: 13px; margin: 0; display: flex; align-items: center; gap: 5px;">
            <i class="bi bi-folder2-open" style="color: #f0883e;"></i> Target Project:
        </label>
        <select id="cadActiveProjectId" style="background: #161b22; color: #e6edf3; border: 1px solid #30363d; border-radius: 6px; padding: 6px 12px; font-size: 13px; max-width: 300px;">
            @if (ViewBag.Projects != null)
            {
                foreach (var p in ViewBag.Projects)
                {
                    <option value="@p.Id" selected="@(p.Id == ViewBag.SelectedProjectId)">
                        @p.ProjectCode — @p.ProjectName
                    </option>
                }
            }
        </select>
    </div>
</div>

<div id="cadStatus" class="alert alert-secondary" role="status">
    Select a DXF file to begin.
</div>

<div class="cad-layout">

    
<aside class="cad-sidebar">

    <!-- Drawing Tools: Expanded by default -->
    <!-- Drawing Tools: Always visible -->
<div class="card cad-inspector-panel cad-tools-panel">

    <div class="card-header">
        <span>
            <i class="bi bi-sliders" aria-hidden="true"></i>
            Drawing tools
        </span>
    </div>

    <div class="card-body cad-tools">

        <button id="fitCad" type="button" title="Fit drawing">
            <i class="bi bi-arrows-fullscreen" aria-hidden="true"></i>
            <span>Fit drawing</span>
        </button>

        <button id="zoomInCad" type="button" title="Zoom in">
            <i class="bi bi-zoom-in" aria-hidden="true"></i>
            <span>Zoom in</span>
        </button>

        <button id="zoomOutCad" type="button" title="Zoom out">
            <i class="bi bi-zoom-out" aria-hidden="true"></i>
            <span>Zoom out</span>
        </button>

        <button id="resetCad" type="button" title="Reset view">
            <i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i>
            <span>Reset view</span>
        </button>

    </div>
</div>


    <!-- Layers: Expanded by default -->
    <details class="card cad-inspector-panel" open>

        <summary class="card-header">
            <span>
                <i class="bi bi-layers" aria-hidden="true"></i>
                Layers
            </span>
            <i class="bi bi-chevron-down panel-chevron"
               aria-hidden="true"></i>
        </summary>

        <div id="cadLayers" class="card-body">
            <span class="text-muted">
                Import a drawing to see its layers.
            </span>
        </div>

    </details>


    <!-- Drawing Information: Collapsed by default -->
    <details class="card cad-inspector-panel">

        <summary class="card-header">
            <span>
                <i class="bi bi-info-circle" aria-hidden="true"></i>
                Drawing information
            </span>
            <i class="bi bi-chevron-down panel-chevron"
               aria-hidden="true"></i>
        </summary>

        <div id="cadInfo" class="card-body">
            No drawing loaded.
        </div>

    </details>

</aside>


        <section class="cad-workspace">

        <div class="card">

            <div class="card-header">
                <span>Drawing workspace</span>

                <span class="text-muted">
                    Mouse wheel: zoom · Drag: pan
                </span>
            </div>

            <div class="card-body p-0 cad-workspace-body" id="cadDropZone">
                <canvas id="cadCanvas"
                        data-parse-url="@Url.Action("Parse", "CadDrawings")"
                        aria-label="Imported CAD drawing"
                        role="img">
                </canvas>

                <!-- Prominent DXF Empty State & Dropzone -->
                <div id="cadEmptyState" class="cad-empty-state-overlay">
                    <div class="cad-empty-card">
                        <div class="cad-empty-icon">
                            <i class="bi bi-file-earmark-ruled"></i>
                        </div>
                        <h3>No 2D Drawing Loaded</h3>
                        <p>
                            Import a <strong>.DXF</strong> file (exported from CulvertCAD Generation or AutoCAD)
                            to inspect culvert cross-sections, longitudinal profiles, and plan layers.
                        </p>
                        <div class="cad-empty-actions">
                            <label for="cadFile" class="btn btn-primary cad-drop-btn">
                                <i class="bi bi-folder2-open"></i> Browse DXF File
                            </label>
                            <span class="cad-drop-hint">or drag and drop your .dxf file here</span>
                        </div>
                    </div>
                </div>
            </div>

        </div>

    </section>

</div>


    <!-- RECENT DRAWINGS SLIDE-OUT DRAWER -->
    <div id="cadHistoryDrawer" class="cad-history-drawer-overlay" hidden>
        <div class="cad-history-drawer">
            <div class="cad-history-header">
                <div>
                    <h3><i class="bi bi-clock-history"></i> Recent 2D CAD Drawings</h3>
                    <p>Saved drawings from your accessible projects</p>
                </div>
                <button type="button" id="btnCloseHistory" class="cad-history-close-btn" aria-label="Close history">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <div class="cad-history-search">
                <i class="bi bi-search"></i>
                <input type="text"
                       id="cadHistorySearch"
                       placeholder="Filter by project code, name, or filename..."
                       autocomplete="off" />
            </div>

            <div id="cadHistoryList" class="cad-history-list">
                <div class="cad-history-loading">
                    <i class="bi bi-arrow-repeat spin"></i>
                    <span>Loading saved drawings...</span>
                </div>
            </div>
        </div>
    </div>
</div>

<form id="cadAntiforgeryForm" class="d-none">
    @Html.AntiForgeryToken()
</form>

@section Scripts {
    <script src="~/js/cad/cad-drawing-viewer.js"
            asp-append-version="true"></script>
}
