@* Views/Projects/Index.cshtml *@
@model List<CulvertCAD.Core.DTOs.ProjectDto>

@{
    ViewData["Title"] = "Projects";
    ViewData["PageTitle"] = "Projects";
    ViewData["PageSubtitle"] =
        $"{Model.Count} project{(Model.Count != 1 ? "s" : "")}";

    ViewData["PageHeaderActions"] = new List<Dictionary<string, string>>
    {
        new()
        {
            ["Text"] = "New Project",
            ["Url"] = Url.Action("Create") ?? "#",
            ["CssClass"] = "btn-primary",
            ["Icon"] = "bi bi-plus-lg"
        }
    };
}

<div class="page">

    <partial name="_PageHeader" />


    @if (!Model.Any())
    {
        <div class="empty-state">

            <i class="bi bi-folder2-open es-icon"
               aria-hidden="true"></i>

            <p>No projects yet. Create your first project.</p>

            <a asp-action="Create"
               class="btn-primary">
                <i class="bi bi-plus-lg" aria-hidden="true"></i>
                <span>New Project</span>
            </a>

        </div>
    }
    else
    {
        <div class="proj-grid">

            @foreach (var project in Model)
            {
                <a asp-action="Details"
                   asp-route-id="@project.Id"
                   class="proj-card">

                    <div class="pc-top">

                        <span class="pc-code">
                            @project.ProjectCode
                        </span>

                        <span class="badge @StatusBadge(project.Status)">
                            @project.Status
                        </span>

                    </div>


                    <h3 class="pc-name">
                        @project.ProjectName
                    </h3>


                    @if (!string.IsNullOrEmpty(project.ClientName))
                    {
                        <p class="pc-meta">
                            <i class="bi bi-building"
                               aria-hidden="true"></i>
                            <span>Client: @project.ClientName</span>
                        </p>
                    }


                    @if (!string.IsNullOrEmpty(project.RoadName))
                    {
                        <p class="pc-meta">
                            <i class="bi bi-signpost-2"
                               aria-hidden="true"></i>
                            <span>@project.RoadName</span>
                        </p>
                    }


                    @if (!string.IsNullOrEmpty(project.ChainageFrom))
                    {
                        <p class="pc-meta">
                            <i class="bi bi-signpost"
                               aria-hidden="true"></i>
                            <span>
                                Ch. @project.ChainageFrom – @project.ChainageTo
                            </span>
                        </p>
                    }


                    <div class="pc-footer">

                        <span>
                            <i class="bi bi-geo-alt"
                               aria-hidden="true"></i>
                            @(project.HasSurveyData ? "Survey available" : "No survey yet")
                        </span>

                        <span>
                            <i class="bi bi-people"
                               aria-hidden="true"></i>
                            @project.Members.Count members
                        </span>

                        @if (project.HasSurveyData)
                        {
                            <span class="badge badge-blue badge-xs">
                                <i class="bi bi-check-circle"
                                   aria-hidden="true"></i>
                                Survey
                            </span>
                        }

                    </div>

                </a>
            }

        </div>
    }

</div>


@functions
{
    string StatusBadge(string status) => status switch
    {
        "Active" => "badge-green",
        "Completed" => "badge-blue",
        "OnHold" => "badge-yellow",
        _ => "badge-gray"
    };
}