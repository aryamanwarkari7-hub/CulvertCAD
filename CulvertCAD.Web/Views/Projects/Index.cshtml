@* Views/Projects/Index.cshtml *@
@model List<CulvertCAD.Core.DTOs.ProjectDto>
@{ ViewData["Title"] = "Projects"; }

<div class="page">
    <div class="page-header">
        <div><h1 class="page-title">Projects</h1><p class="page-sub">@Model.Count project@(Model.Count != 1 ? "s" : "")</p></div>
        <a asp-action="Create" class="btn-primary">＋ New Project</a>
    </div>

    @if (!Model.Any())
    {
        <div class="empty-state">
            <div class="es-icon">📁</div>
            <p>No projects yet. Create your first project.</p>
            <a asp-action="Create" class="btn-primary">＋ New Project</a>
        </div>
    }
    else
    {
        <div class="proj-grid">
            @foreach (var p in Model)
            {
                <a asp-action="Details" asp-route-id="@p.Id" class="proj-card">
                    <div class="pc-top">
                        <span class="pc-code">@p.ProjectCode</span>
                        <span class="badge @StatusBadge(p.Status)">@p.Status</span>
                    </div>
                    <h3 class="pc-name">@p.ProjectName</h3>
                    @if (!string.IsNullOrEmpty(p.ClientName)) { <p class="pc-meta">Client: @p.ClientName</p> }
                    @if (!string.IsNullOrEmpty(p.RoadName)) { <p class="pc-meta">🛣 @p.RoadName</p> }
                    @if (!string.IsNullOrEmpty(p.ChainageFrom)) { <p class="pc-meta">Ch. @p.ChainageFrom – @p.ChainageTo</p> }
                    <div class="pc-footer">
                        <span>📐 @p.DesignCount designs</span>
                        <span>👥 @p.Members.Count members</span>
                        @if (p.HasSurveyData) { <span class="badge badge-blue badge-xs">Survey ✓</span> }
                    </div>
                </a>
            }
        </div>
    }
</div>

@functions {
    string StatusBadge(string s) => s switch { "Active"=>"badge-green","Completed"=>"badge-blue","OnHold"=>"badge-yellow",_=>"badge-gray" };
}
