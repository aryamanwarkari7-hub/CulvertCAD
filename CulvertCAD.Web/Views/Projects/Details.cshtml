@* Views/Projects/Details.cshtml *@
@model CulvertCAD.Core.DTOs.ProjectDto

@{
    ViewData["Title"] = Model.ProjectName;

    ViewData["PageTitle"] = Model.ProjectName;
    ViewData["PageSubtitle"] = Model.Location;
    ViewData["PageRegion"] = Model.State;

    ViewData["PageHeaderBreadcrumbs"] =
        new List<Dictionary<string, string>>
        {
            new()
            {
                ["Text"] = "Projects",
                ["Url"] = Url.Action("Index", "Projects")!
            },
            new()
            {
                ["Text"] = Model.ProjectCode
            }
        };

    ViewData["PageHeaderActions"] =
        new List<Dictionary<string, string>>
        {
            new()
            {
                ["Text"] = "Survey Data",
                ["Url"] = Url.Action(
                    "Upload", "Survey",
                    new { projectId = Model.Id })!,
                ["Icon"] = "bi bi-bar-chart-line",
                ["CssClass"] = "btn-ghost"
            },
            new()
            {
                ["Text"] = "New Design",
                ["Url"] = Url.Action(
                    "Create", "Designs",
                    new { projectId = Model.Id })!,
                ["Icon"] = "bi bi-plus-lg",
                ["CssClass"] = "btn-primary"
            }
        };

    var designs =
        ViewBag.Designs as List<CulvertCAD.Core.DTOs.CulvertDesignDto>
        ?? new();

    var summary =
        ViewBag.SurveySummary as CulvertCAD.Core.DTOs.SurveySummaryDto;
}


<div class="page">

    <!-- =====================================================
         Page Header
         ===================================================== -->

    <partial name="_PageHeader" />


    <!-- =====================================================
         Project Metadata
         ===================================================== -->

    <div class="meta-strip">

        @if (!string.IsNullOrEmpty(Model.ClientName))
        {
            <div class="mi">
                <span class="mi-lbl">Client</span>
                <span class="mi-val">@Model.ClientName</span>
            </div>
        }

        @if (!string.IsNullOrEmpty(Model.ConsultantName))
        {
            <div class="mi">
                <span class="mi-lbl">Consultant</span>
                <span class="mi-val">@Model.ConsultantName</span>
            </div>
        }

        @if (!string.IsNullOrEmpty(Model.RoadName))
        {
            <div class="mi">
                <span class="mi-lbl">Road</span>
                <span class="mi-val">@Model.RoadName</span>
            </div>
        }

        @if (!string.IsNullOrEmpty(Model.ChainageFrom))
        {
            <div class="mi">
                <span class="mi-lbl">Chainage</span>
                <span class="mi-val">
                    @Model.ChainageFrom – @Model.ChainageTo
                </span>
            </div>
        }

        
        <div class="mi">
            <span class="mi-lbl">Status</span>
            <span class="project-status-pill @(string.Equals(Model.Status, "Active", StringComparison.OrdinalIgnoreCase) ? "project-status-active" : "project-status-inactive")">
                <span class="project-status-dot"></span>
                @Model.Status
            </span>
        </div>


    </div>

    
    <!-- =====================================================
         Survey Summary
         ===================================================== -->
    @if (summary != null)
    {
        <section class="survey-summary" aria-label="Survey Summary">

            <div class="survey-summary-header">
                <div>
                    <h2>Survey Data</h2>
                    <p>Survey information available for this project</p>
                </div>

                <span class="survey-status">
                    <span class="survey-status-dot"></span>
                    Loaded
                </span>
            </div>

            <div class="survey-metrics">

                <article class="survey-metric-card">
                    <div class="survey-metric-icon points-icon">
                        <i class="bi bi-geo-alt" aria-hidden="true"></i>
                    </div>

                    <div class="survey-metric-content">
                        <span class="survey-metric-label">Survey Points</span>
                        <strong class="survey-metric-value">
                            @summary.TotalPoints.ToString("N0")
                        </strong>
                        <span class="survey-metric-description">
                            Imported data points
                        </span>
                    </div>
                </article>

                <article class="survey-metric-card">
                    <div class="survey-metric-icon culverts-icon">
                        <i class="bi bi-geo" aria-hidden="true"></i>
                    </div>

                    <div class="survey-metric-content">
                        <span class="survey-metric-label">Culvert Locations</span>
                        <strong class="survey-metric-value">
                            @summary.DetectedCulverts.ToString("N0")
                        </strong>
                        <span class="survey-metric-description">
                            Detected locations
                        </span>
                    </div>
                </article>

                <article class="survey-metric-card">
                    <div class="survey-metric-icon alignment-icon">
                        <i class="bi bi-signpost-2" aria-hidden="true"></i>
                    </div>

                    <div class="survey-metric-content">
                        <span class="survey-metric-label">Alignment Length</span>
                        <strong class="survey-metric-value">
                            @((summary.AlignmentLengthM / 1000).ToString("0.00"))
                            <span class="survey-metric-unit">km</span>
                        </strong>
                        <span class="survey-metric-description">
                            Surveyed road alignment
                        </span>
                    </div>
                </article>

            </div>

            <div class="survey-summary-footer">
                <span class="survey-summary-note">
                    <i class="bi bi-info-circle" aria-hidden="true"></i>
                    Review the imported survey and detected locations.
                </span>

                <a asp-controller="Survey"
                   asp-action="Review"
                   asp-route-projectId="@Model.Id"
                   class="survey-analysis-link">

                    View Survey Analysis

                    <i class="bi bi-arrow-right" aria-hidden="true"></i>
                </a>
            </div>

        </section>
    }

    


    <!-- =====================================================
         Project Tabs
         ===================================================== -->

    <div class="tab-bar">

        <button type="button"
                class="tab active"
                data-tab="designs"
                onclick="showTab('designs', this)">

            <i class="bi bi-rulers"
               aria-hidden="true"></i>

            <span>
                Designs (@designs.Count)
            </span>

        </button>

        <button type="button"
                class="tab"
                data-tab="members"
                onclick="showTab('members', this)">

            <i class="bi bi-people"
               aria-hidden="true"></i>

            <span>
                Members (@Model.Members.Count)
            </span>

        </button>

    </div>


    <!-- =====================================================
         Designs Tab
         ===================================================== -->

    <div id="tab-designs">

        @if (!designs.Any())
        {
            <div class="empty-state">

                <i class="bi bi-rulers es-icon"
                   aria-hidden="true"></i>

                <p>No designs yet.</p>

                <a asp-controller="Designs"
                   asp-action="Create"
                   asp-route-projectId="@Model.Id"
                   class="btn-primary">

                    <i class="bi bi-plus-lg"
                       aria-hidden="true"></i>

                    <span>Create First Design</span>

                </a>

            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="dt">

                    <thead>
                        <tr>
                            <th>Code</th>
                            <th>Design Name</th>
                            <th>Chainage</th>
                            <th>Type</th>
                            <th>Q (m³/s)</th>
                            <th>Revisions</th>
                            <th>Status</th>
                            <th>Actions</th>

                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var design in designs)
                        {
                            <tr>

                                <td>
                                    <code>
                                        @(design.DesignCode ?? "—")
                                    </code>
                                </td>

                                <td>
                                    <strong>
                                        @design.DesignName
                                    </strong>

                                    <br />

                                    <small>
                                        @design.CulvertLocation
                                    </small>
                                </td>

                                <td>
                                    @(design.Chainage ?? "—")
                                </td>

                                <td>
                                    @design.CulvertType
                                </td>

                                <td>
                                    @(design.DesignDischargeQ?
                                        .ToString("0.000") ?? "—")
                                </td>

                                <td>
                                    <span class="badge badge-gray">
                                        @design.RevisionCount rev
                                    </span>
                                </td>

                                <td>
                                    <span class="badge @RevBadge(design.LatestRevisionStatus)">
                                        @(design.LatestRevisionStatus ?? "Draft")
                                    </span>
                                </td>

                                <td>
                                    <a asp-controller="Designs"
                                       asp-action="Details"
                                       asp-route-id="@design.Id"
                                       class="btn-xs"
                                       title="View Design"
                                       aria-label="View Design">

                                        <i class="bi bi-eye" aria-hidden="true"></i>

                                    </a>
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

    </div>


    <!-- =====================================================
         Members Tab
         ===================================================== -->

    <div id="tab-members" class="tab-panel-hidden">

        <div class="members-grid">

            @if (!Model.Members.Any())
            {
                <div class="empty-state">
                    <i class="bi bi-people es-icon" aria-hidden="true"></i>

                    <p>No project members assigned.</p>
                </div>
            }
            else
            {
                @foreach (var member in Model.Members)
                {
                    <div class="member-card">

                        <div class="member-av">
                            @(member.FullName?.FirstOrDefault() ?? '?')
                        </div>

                        <div class="member-info">
                            <strong>@member.FullName</strong>
                            <span>@member.Email</span>
                        </div>

                        <span class="badge badge-blue">
                            @member.Role
                        </span>

                    </div>
                }
            }

        </div>

    </div>

</div>


@section Scripts {
    <script>
        function showTab(tab, button) {
            const designs = document.getElementById('tab-designs');
            const members = document.getElementById('tab-members');

            designs.classList.toggle('tab-panel-hidden', tab !== 'designs');
            members.classList.toggle('tab-panel-hidden', tab !== 'members');

            document
                .querySelectorAll('.tab')
                .forEach(tabButton => {
                    tabButton.classList.remove('active');
                });

            button.classList.add('active');
        }
    </script>
}


@functions {
    string RevBadge(string? status) => status switch
    {
        "Approved"         => "badge-green",
        "Submitted"        => "badge-yellow",
        "UnderReview"      => "badge-blue",
        "RevisionRequired" => "badge-red",
        _                  => "badge-gray"
    };
}