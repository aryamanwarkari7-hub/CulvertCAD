@* Views/Home/Index.cshtml *@
@model CulvertCAD.Core.DTOs.DashboardDto

@{
    ViewData["Title"] = "Dashboard";
}

<div class="page">

    <div class="page-header">
        <div>
            <h1 class="page-title">Dashboard</h1>
            <p class="page-sub">
                Welcome back, @User.FindFirst("FullName")?.Value
            </p>
        </div>

        <a asp-controller="Projects"
           asp-action="Create"
           class="btn-primary">
            ＋ New Project
        </a>
    </div>


    <!-- =====================================================
         Dashboard Statistics
         ===================================================== -->

    <div class="stat-grid">

        <div class="stat-card">
            <div class="stat-icon stat-icon-accent">
                <i class="bi bi-folder2-open" aria-hidden="true"></i>
            </div>

            <div class="stat-body">
                <div class="stat-val">@Model.TotalProjects</div>
                <div class="stat-lbl">Total Projects</div>
            </div>
        </div>


        <div class="stat-card">
            <div class="stat-icon stat-icon-success">
                <i class="bi bi-check-circle" aria-hidden="true"></i>
            </div>

            <div class="stat-body">
                <div class="stat-val">@Model.ActiveProjects</div>
                <div class="stat-lbl">Active Projects</div>
            </div>
        </div>


        <div class="stat-card">
            <div class="stat-icon stat-icon-info">
                <i class="bi bi-rulers" aria-hidden="true"></i>
            </div>

            <div class="stat-body">
                <div class="stat-val">@Model.TotalDesigns</div>
                <div class="stat-lbl">Total Designs</div>
            </div>
        </div>


        <div class="stat-card">
            <div class="stat-icon stat-icon-warning">
                <i class="bi bi-hourglass-split" aria-hidden="true"></i>
            </div>

            <div class="stat-body">
                <div class="stat-val">@Model.PendingReviews</div>
                <div class="stat-lbl">Pending Reviews</div>
            </div>
        </div>


        <div class="stat-card">
            <div class="stat-icon stat-icon-purple">
                <i class="bi bi-patch-check" aria-hidden="true"></i>
            </div>

            <div class="stat-body">
                <div class="stat-val">@Model.ApprovedDesigns</div>
                <div class="stat-lbl">Approved Designs</div>
            </div>
        </div>

    </div>


    <!-- =====================================================
         Dashboard Columns
         ===================================================== -->

    <div class="dash-cols">

        <!-- Recent Activity -->

        <div class="card">

            <div class="card-hd">
                <h3>Recent Activity</h3>
            </div>

            <div class="activity-feed">

                @if (!Model.RecentActivity.Any())
                {
                    <div class="empty-feed">
                        No recent activity
                    </div>
                }
                else
                {
                    @foreach (var activity in Model.RecentActivity)
                    {
                        <div class="act-row">

                            <div class="act-dot @StatusClass(activity.Type)"></div>

                            <div class="act-body">
                                <span class="act-desc">
                                    @activity.Description
                                </span>

                                <span class="act-meta">
                                    @activity.UserName
                                    ·
                                    @activity.Timestamp.ToString("dd MMM yyyy")
                                </span>
                            </div>

                        </div>
                    }
                }

            </div>

        </div>


        <!-- My Projects -->

        <div class="card">

            <div class="card-hd">
                <h3>My Projects</h3>
            </div>

            <div class="quick-actions">

                @if (!Model.MyProjects.Any())
                {
                    <div class="empty-feed">
                        No projects found
                    </div>
                }
                else
                {
                    @foreach (var project in Model.MyProjects)
                    {
                        <a asp-controller="Projects"
                           asp-action="Details"
                           asp-route-id="@project.Id"
                           class="qa-btn">

                            <span>
                                <i class="bi bi-folder2-open" aria-hidden="true"></i>
                                @project.ProjectCode —
                                @project.ProjectName
                                (@project.DesignCount designs)
                            </span>

                        </a>
                    }
                }

            </div>


            <!-- Design Standards -->

            <div class="is-codes-panel">

                <h4>Design Standards</h4>

                <div class="is-code-item">
                    <span class="is-dot"></span>
                    <span>
                        IS 783:1985 — Laying of Concrete Pipes
                    </span>
                </div>

                <div class="is-code-item">
                    <span class="is-dot"></span>
                    <span>
                        IS 458:2003 — Precast Concrete Pipes
                    </span>
                </div>

                <div class="is-code-item">
                    <span class="is-dot"></span>
                    <span>
                        IRC 89:1997 — Road Culverts
                    </span>
                </div>

            </div>

        </div>

    </div>

</div>


@functions {

    string StatusClass(string status) => status switch
    {
        "Approved" => "act-dot-approved",
        "Submitted" => "act-dot-submitted",
        "UnderReview" => "act-dot-review",
        "RevisionRequired" => "act-dot-revision",
        _ => "act-dot-default"
    };
}