@* Views/Home/Index.cshtml *@
@model CulvertCAD.Core.DTOs.DashboardDto

@{
    ViewData["Title"] = "Dashboard";
    ViewData["PageTitle"] = "Dashboard";
    ViewData["PageSubtitle"] =
        $"Welcome back, {User.FindFirst("FullName")?.Value ?? "User"}";

    ViewData["PageHeaderActions"] = new List<Dictionary<string, string>>
    {
        new()
        {
            ["Text"] = "New Project",
            ["Url"] = Url.Action("Create", "Projects") ?? "#",
            ["CssClass"] = "btn-primary",
            ["Icon"] = "bi bi-plus-lg"
        }
    };
}

<div class="page">
    <partial name="_PageHeader" />


    <!-- =====================================================
         Dashboard Statistics
         ===================================================== -->

    <div class="stat-grid">

        <div class="stat-card">
            <div class="stat-icon stat-icon-accent">
                <i class="bi bi-folder2-open" aria-hidden="true"></i>
            </div>

            <div class="stat-body">
                <div class="stat-val">@Model.TotalProjects</div>
                <div class="stat-lbl">Total Projects</div>
            </div>
        </div>


        <div class="stat-card">
            <div class="stat-icon stat-icon-success">
                <i class="bi bi-check-circle" aria-hidden="true"></i>
            </div>

            <div class="stat-body">
                <div class="stat-val">@Model.ActiveProjects</div>
                <div class="stat-lbl">Active Projects</div>
            </div>
        </div>


        <div class="stat-card">
            <div class="stat-icon stat-icon-info">
                <i class="bi bi-rulers" aria-hidden="true"></i>
            </div>

            <div class="stat-body">
                <div class="stat-val">@Model.TotalDesigns</div>
                <div class="stat-lbl">Total Designs</div>
            </div>
        </div>


        <div class="stat-card">
            <div class="stat-icon stat-icon-warning">
                <i class="bi bi-hourglass-split" aria-hidden="true"></i>
            </div>

            <div class="stat-body">
                <div class="stat-val">@Model.PendingReviews</div>
                <div class="stat-lbl">Pending Reviews</div>
            </div>
        </div>


        <div class="stat-card">
            <div class="stat-icon stat-icon-purple">
                <i class="bi bi-patch-check" aria-hidden="true"></i>
            </div>

            <div class="stat-body">
                <div class="stat-val">@Model.ApprovedDesigns</div>
                <div class="stat-lbl">Approved Designs</div>
            </div>
        </div>

    </div>


    
    <!-- =====================================================
         Dashboard Columns
         ===================================================== -->

    <div class="dash-cols dashboard-panels">

        <!-- Recent Activity -->
        <section class="card dashboard-panel activity-card">

            <div class="card-hd dashboard-panel-header">
                <div class="dashboard-panel-heading">
                    <div class="dashboard-panel-icon activity-panel-icon">
                        <i class="bi bi-activity" aria-hidden="true"></i>
                    </div>

                    <div>
                        <h3>Recent Activity</h3>
                        <p>Latest design and revision updates</p>
                    </div>
                </div>

                <span class="panel-count">
                    @Model.RecentActivity.Count()
                </span>
            </div>

            <div class="activity-feed">

                @if (!Model.RecentActivity.Any())
                {
                    <div class="dashboard-empty">
                        <i class="bi bi-activity" aria-hidden="true"></i>
                        <strong>No recent activity</strong>
                        <span>Design and revision updates will appear here.</span>
                    </div>
                }
                else
                {
                    @foreach (var activity in Model.RecentActivity)
                    {
                        <article class="act-row">

                            <div class="act-status-icon @StatusClass(activity.Type)">
                                @switch (activity.Type)
                                {
                                    case "Approved":
                                        <i class="bi bi-check-lg" aria-hidden="true"></i>
                                        break;
                                    case "Submitted":
                                        <i class="bi bi-send" aria-hidden="true"></i>
                                        break;
                                    case "UnderReview":
                                        <i class="bi bi-eye" aria-hidden="true"></i>
                                        break;
                                    case "RevisionRequired":
                                        <i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i>
                                        break;
                                    default:
                                        <i class="bi bi-file-earmark-text" aria-hidden="true"></i>
                                        break;
                                }
                            </div>

                            <div class="act-body">

                                <div class="act-heading">
                                    <span class="act-desc">
                                        @activity.Description
                                    </span>

                                    <span class="activity-status-pill @StatusClass(activity.Type)">
                                        @switch (activity.Type)
                                        {
                                            case "Approved":
                                                <text>Approved</text>
                                                break;
                                            case "Submitted":
                                                <text>Submitted</text>
                                                break;
                                            case "UnderReview":
                                                <text>Under Review</text>
                                                break;
                                            case "RevisionRequired":
                                                <text>Revision Required</text>
                                                break;
                                            default:
                                                <text>Draft</text>
                                                break;
                                        }
                                    </span>
                                </div>

                                <div class="act-footer">
                                    <span class="act-meta">
                                        <i class="bi bi-person-circle" aria-hidden="true"></i>
                                        <span>@activity.UserName</span>
                                    </span>

                                    <span class="act-date">
                                        <i class="bi bi-clock" aria-hidden="true"></i>
                                        <time datetime="@activity.Timestamp.ToString("yyyy-MM-dd")">
                                            @activity.Timestamp.ToString("dd MMM yyyy")
                                        </time>
                                    </span>
                                </div>

                            </div>

                        </article>
                    }
                }

            </div>

        </section>


        <!-- My Projects and Design Standards -->
        <section class="card dashboard-panel projects-panel">

            <div class="card-hd dashboard-panel-header">
                <div class="dashboard-panel-heading">
                    <div class="dashboard-panel-icon projects-panel-icon">
                        <i class="bi bi-folder2-open" aria-hidden="true"></i>
                    </div>

                    <div>
                        <h3>My Projects</h3>
                        <p>Your accessible projects</p>
                    </div>
                </div>

                <span class="panel-count">
                    @Model.MyProjects.Count()
                </span>
            </div>

            <div class="project-card-list">

                @if (!Model.MyProjects.Any())
                {
                    <div class="dashboard-empty">
                        <i class="bi bi-folder2" aria-hidden="true"></i>
                        <strong>No projects found</strong>
                        <span>Create a project to get started.</span>
                    </div>
                }
                else
                {
                    @foreach (var project in Model.MyProjects)
                    {
                        <a asp-controller="Projects"
                           asp-action="Details"
                           asp-route-id="@project.Id"
                           class="dashboard-project-card">

                            <div class="project-card-icon">
                                <i class="bi bi-folder2-open" aria-hidden="true"></i>
                            </div>

                            <div class="project-card-content">
                                <span class="project-card-code">
                                    @project.ProjectCode
                                </span>

                                <strong class="project-card-name">
                                    @project.ProjectName
                                </strong>

                                <span class="project-card-meta">
                                    <i class="bi bi-rulers" aria-hidden="true"></i>
                                    @project.DesignCount
                                    @(project.DesignCount == 1 ? "design" : "designs")
                                </span>
                            </div>

                            <div class="project-card-arrow">
                                <i class="bi bi-arrow-up-right" aria-hidden="true"></i>
                            </div>

                        </a>
                    }
                }

            </div>

            <!-- Design Standards -->
            <div class="standards-section">

                <div class="standards-header">
                    <div class="standards-heading-icon">
                        <i class="bi bi-journal-check" aria-hidden="true"></i>
                    </div>

                    <div>
                        <h4>Design Standards</h4>
                        <p>Applicable reference standards</p>
                    </div>
                </div>

                <div class="standards-list">

                    <div class="standard-item">
                        <span class="standard-code">IS</span>
                        <div class="standard-content">
                            <strong>IS 783:1985</strong>
                            <span>Laying of Concrete Pipes</span>
                        </div>
                    </div>

                    <div class="standard-item">
                        <span class="standard-code">IS</span>
                        <div class="standard-content">
                            <strong>IS 458:2003</strong>
                            <span>Precast Concrete Pipes</span>
                        </div>
                    </div>

                    <div class="standard-item">
                        <span class="standard-code standard-code-irc">IRC</span>
                        <div class="standard-content">
                            <strong>IRC 89:1997</strong>
                            <span>Road Culverts</span>
                        </div>
                    </div>

                </div>

            </div>

        </section>

    </div>


</div>


@functions {

    string StatusClass(string status) => status switch
    {
        "Approved" => "act-dot-approved",
        "Submitted" => "act-dot-submitted",
        "UnderReview" => "act-dot-review",
        "RevisionRequired" => "act-dot-revision",
        _ => "act-dot-default"
    };
}