@* Views/Home/Index.cshtml *@
@model CulvertCAD.Core.DTOs.DashboardDto

@{
    ViewData["Title"] = "Dashboard";
    ViewData["PageTitle"] = "Dashboard";
    ViewData["PageSubtitle"] =
        $"Welcome back, {User.FindFirst("FullName")?.Value ?? "User"}";

    ViewData["PageHeaderActions"] = new List<Dictionary<string, string>>
    {
        new()
        {
            ["Text"] = "New Project",
            ["Url"] = Url.Action("Create", "Projects") ?? "#",
            ["CssClass"] = "btn-primary",
            ["Icon"] = "bi bi-plus-lg"
        }
    };
}

<div class="page">
    <partial name="_PageHeader" />


    <!-- =====================================================
         Dashboard Statistics
         ===================================================== -->

    <div class="stat-grid">

        <div class="stat-card">
            <div class="stat-icon stat-icon-accent">
                <i class="bi bi-folder2-open" aria-hidden="true"></i>
            </div>

            <div class="stat-body">
                <div class="stat-val">@Model.TotalProjects</div>
                <div class="stat-lbl">Total Projects</div>
            </div>
        </div>


        <div class="stat-card">
            <div class="stat-icon stat-icon-success">
                <i class="bi bi-check-circle" aria-hidden="true"></i>
            </div>

            <div class="stat-body">
                <div class="stat-val">@Model.ActiveProjects</div>
                <div class="stat-lbl">Active Projects</div>
            </div>
        </div>


    </div>



    <!-- =====================================================
         Dashboard Columns
         ===================================================== -->

    <div class="dash-cols dashboard-panels">




        <!-- My Projects and Design Standards -->
        <section class="card dashboard-panel projects-panel">

            <div class="card-hd dashboard-panel-header">
                <div class="dashboard-panel-heading">
                    <div class="dashboard-panel-icon projects-panel-icon">
                        <i class="bi bi-folder2-open" aria-hidden="true"></i>
                    </div>

                    <div>
                        <h3>My Projects</h3>
                        <p>Your accessible projects</p>
                    </div>
                </div>

                <span class="panel-count">
                    @Model.MyProjects.Count()
                </span>
            </div>

            <div class="project-card-list">

                @if (!Model.MyProjects.Any())
                {
                    <div class="dashboard-empty">
                        <i class="bi bi-folder2" aria-hidden="true"></i>
                        <strong>No projects found</strong>
                        <span>Create a project to get started.</span>
                    </div>
                }
                else
                {
                    @foreach (var project in Model.MyProjects)
                    {
                        <a asp-controller="Projects"
                           asp-action="Details"
                           asp-route-id="@project.Id"
                           class="dashboard-project-card">

                            <div class="project-card-icon">
                                <i class="bi bi-folder2-open" aria-hidden="true"></i>
                            </div>

                            <div class="project-card-content">
                                <span class="project-card-code">
                                    @project.ProjectCode
                                </span>

                                <strong class="project-card-name">
                                    @project.ProjectName
                                </strong>

                                <span class="project-card-meta">
                                    <i class="bi bi-info-circle" aria-hidden="true"></i>
                                    @project.Status
                                </span>
                            </div>

                            <div class="project-card-arrow">
                                <i class="bi bi-arrow-up-right" aria-hidden="true"></i>
                            </div>

                        </a>
                    }
                }

            </div>

            <!-- Design Standards -->
            <div class="standards-section">

                <div class="standards-header">
                    <div class="standards-heading-icon">
                        <i class="bi bi-journal-check" aria-hidden="true"></i>
                    </div>

                    <div>
                        <h4>Design Standards</h4>
                        <p>Applicable reference standards</p>
                    </div>
                </div>

                <div class="standards-list">

                    <div class="standard-item">
                        <span class="standard-code">IS</span>
                        <div class="standard-content">
                            <strong>IS 783:1985</strong>
                            <span>Laying of Concrete Pipes</span>
                        </div>
                    </div>

                    <div class="standard-item">
                        <span class="standard-code">IS</span>
                        <div class="standard-content">
                            <strong>IS 458:2003</strong>
                            <span>Precast Concrete Pipes</span>
                        </div>
                    </div>

                    <div class="standard-item">
                        <span class="standard-code standard-code-irc">IRC</span>
                        <div class="standard-content">
                            <strong>IRC 89:1997</strong>
                            <span>Road Culverts</span>
                        </div>
                    </div>

                </div>

            </div>

        </section>

    </div>


</div>


@functions {

    string StatusClass(string status) => status switch
    {
        "Approved" => "act-dot-approved",
        "Submitted" => "act-dot-submitted",
        "UnderReview" => "act-dot-review",
        "RevisionRequired" => "act-dot-revision",
        _ => "act-dot-default"
    };
}
