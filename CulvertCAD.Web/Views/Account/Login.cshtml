@* Views/Account/Login.cshtml *@
@model CulvertCAD.Core.DTOs.LoginDto

@{
    Layout = null;
}

<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Sign In — CulvertCAD</title>

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

</head>

<body>

    <div class="login-page">

        <div class="login-bg">
            <div class="bg-grid"></div>
            <div class="bg-orb orb-1"></div>
            <div class="bg-orb orb-2"></div>
        </div>


        <div class="login-card">

            <!-- =============================================
                 BRAND
                 ============================================= -->

            <div class="login-brand">

                <div class="brand-glyph">
                    <i class="bi bi-bounding-box" aria-hidden="true"></i>
                </div>

                <h1>
                    CulvertCAD
                </h1>

                <p class="brand-sub">
                    Pipe Culvert Design System
                </p>


                <div class="is-chips">

                    <span>
                        IS 783
                    </span>

                    <span>
                        IS 458
                    </span>

                    <span>
                        IRC 89
                    </span>

                    <span>
                        IRC SP 13
                    </span>

                </div>

            </div>


            <!-- =============================================
                 LOGIN FORM
                 ============================================= -->

            <form asp-controller="Account"
                  asp-action="Login"
                  asp-route-returnUrl="@ViewData["ReturnUrl"]"
                  method="post"
                  class="login-form">

                @Html.AntiForgeryToken()


                <div asp-validation-summary="ModelOnly"
                     class="alert-error">
                </div>


                <div class="field-group">

                    <label asp-for="Email">
                        Email Address
                    </label>

                    <div class="login-input-wrap">

                        <i class="bi bi-envelope"
                           aria-hidden="true"></i>

                        <input asp-for="Email"
                               type="email"
                               class="field-input"
                               placeholder="engineer@organisation.in"
                               autocomplete="email" />

                    </div>

                    <span asp-validation-for="Email"
                          class="field-validation">
                    </span>

                </div>


                <div class="field-group">

                    <label asp-for="Password">
                        Password
                    </label>

                    <div class="login-input-wrap">

                        <i class="bi bi-lock"
                           aria-hidden="true"></i>

                        <input asp-for="Password"
                               type="password"
                               class="field-input"
                               placeholder="••••••••"
                               autocomplete="current-password" />

                    </div>

                    <span asp-validation-for="Password"
                          class="field-validation">
                    </span>

                </div>


                <div class="field-checkbox">

                    <input asp-for="RememberMe"
                           type="checkbox"
                           id="rememberMe" />

                    <label for="rememberMe">
                        Remember me
                    </label>

                </div>


                <button type="submit"
                        class="btn-signin">

                    <span>Sign In</span>

                    <i class="bi bi-arrow-right"
                       aria-hidden="true"></i>

                </button>

            </form>


            <p class="login-hint">
                Default: admin@culvertcad.in / Admin@123
            </p>


            <footer class="login-footer">
                IS 783:1985 · IS 458:2003 · IRC 89:1997 · IRC SP 13:2004
            </footer>

        </div>

    </div>

</body>

</html>