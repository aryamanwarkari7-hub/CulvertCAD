@* Views/Account/Login.cshtml *@
@model CulvertCAD.Core.DTOs.LoginDto

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sign In — Culvert Locator</title>
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />
</head>
<body>
    <div class="login-page">
        <div class="login-bg">
            <div class="bg-grid"></div>
            <div class="bg-orb orb-1"></div>
            <div class="bg-orb orb-2"></div>
        </div>

        <div class="login-split-wrapper">
            <!-- =============================================
                 LEFT COLUMN: CULVERT LOCATOR HERO SHOWCASE
                 ============================================= -->
            <div class="login-hero">
                <div class="hero-image-container">
                    <img src="~/images/culvert-locator-hero.png"
                         alt="CulvertCAD 3D Culvert Locator & Terrain Model"
                         class="hero-img"
                         asp-append-version="true" />
                    <div class="hero-image-overlay"></div>
                </div>

                <div class="hero-content">
                    <div class="hero-tag">
                        <i class="bi bi-geo-alt-fill" aria-hidden="true"></i>
                        <span>Culvert Locator Engine</span>
                    </div>

                    <h2 class="hero-title">
                        Precision Culvert Mapping &amp; 3D Solid CAD
                    </h2>

                    <p class="hero-desc">
                        Automated highway survey alignment, Delaunay terrain triangulation, and parametric 3D solid placement.
                    </p>

                    <div class="hero-highlights-cards">
                        <div class="highlight-card">
                            <div class="highlight-card-icon">
                                <i class="bi bi-layers-half" aria-hidden="true"></i>
                            </div>
                            <strong>Terrain Triangulation</strong>
                            <span>Real-time TIN surface &amp; contour elevation</span>
                        </div>

                        <div class="highlight-card">
                            <div class="highlight-card-icon">
                                <i class="bi bi-box" aria-hidden="true"></i>
                            </div>
                            <strong>3D Solid Placement</strong>
                            <span>Dynamic ACIS pipe &amp; box models</span>
                        </div>

                        <div class="highlight-card">
                            <div class="highlight-card-icon">
                                <i class="bi bi-patch-check" aria-hidden="true"></i>
                            </div>
                            <strong>IRC &amp; IS Standards</strong>
                            <span>IS 783, 458, IRC 89 &amp; SP 13</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- =============================================
                 RIGHT COLUMN: LOGIN FORM CARD
                 ============================================= -->
            <div class="login-card">
                <div class="login-brand">
                    <div class="brand-glyph brand-glyph-login">
                        <i class="bi bi-geo-alt-fill" aria-hidden="true"></i>
                    </div>
                    <h1>Culvert Locator</h1>
                    <p class="brand-sub">Survey and Culvert Location Mapping</p>
                    <div class="is-chips">
                        <span>IS 783</span>
                        <span>IS 458</span>
                        <span>IRC 89</span>
                        <span>IRC SP 13</span>
                    </div>
                </div>

                <form asp-controller="Account"
                      asp-action="Login"
                      asp-route-returnUrl="@ViewData["ReturnUrl"]"
                      method="post"
                      class="login-form">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="alert-error"></div>

                    <div class="field-group">
                        <label asp-for="Email">Email Address</label>
                        <div class="login-input-wrap">
                            <i class="bi bi-envelope" aria-hidden="true"></i>
                            <input asp-for="Email"
                                   type="email"
                                   class="field-input"
                                   placeholder="engineer@organisation.in"
                                   autocomplete="email" />
                        </div>
                        <span asp-validation-for="Email" class="field-validation"></span>
                    </div>

                    <div class="field-group">
                        <label asp-for="Password">Password</label>
                        <div class="login-input-wrap">
                            <i class="bi bi-lock" aria-hidden="true"></i>
                            <input asp-for="Password"
                                   type="password"
                                   class="field-input"
                                   placeholder="••••••••"
                                   autocomplete="current-password" />
                        </div>
                        <span asp-validation-for="Password" class="field-validation"></span>
                    </div>

                    <div class="field-checkbox">
                        <input asp-for="RememberMe" type="checkbox" id="rememberMe" />
                        <label for="rememberMe">Remember me</label>
                    </div>

                    <button type="submit" class="btn-signin">
                        <span>Sign In</span>
                        <i class="bi bi-arrow-right" aria-hidden="true"></i>
                    </button>
                </form>

                @* <p class="login-hint">
                    Default: admin@culvertcad.in / Admin@123
                </p> *@

                <footer class="login-footer">
                    <span>Need access or reset? </span>
                    <a href="mailto:support@culvertcad.in" style="color: var(--acc); text-decoration: none;">Contact Administrator</a>
                </footer>
            </div>
        </div>
    </div>
</body>
</html>
