@* Views/Designs/Create.cshtml *@
@model CulvertCAD.Core.DTOs.CreateDesignDto

@{
    ViewData["Title"] = "New Design";
}

<div class="page">

    <div class="page-header">
        <div>

            <div class="breadcrumb">
                <a asp-controller="Projects"
                   asp-action="Index">
                    <i class="bi bi-folder2-open" aria-hidden="true"></i>
                    Projects
                </a>

                <span>/</span>

                <a asp-controller="Projects"
                   asp-action="Details"
                   asp-route-id="@ViewBag.ProjectId">
                    @ViewBag.ProjectName
                </a>

                <span>/</span>

                New Design
            </div>

            <h1 class="page-title">
                New Culvert Design
            </h1>

        </div>
    </div>


    <form asp-action="Create"
          asp-route-projectId="@ViewBag.ProjectId"
          method="post"
          class="card design-form">

        @Html.AntiForgeryToken()


        <!-- =================================================
             Validation
             ================================================= -->

        <partial name="_ValidationSummary" />


        <!-- =================================================
             General Information
             ================================================= -->

        <div class="form-section">

            <div class="form-section-header">
                <i class="bi bi-info-circle" aria-hidden="true"></i>

                <div>
                    <h3>General Information</h3>
                    <p>Basic identification and location of the culvert.</p>
                </div>
            </div>


            <div class="form-row-2">

                <div class="fg">
                    <label asp-for="DesignName">
                        Design Name
                        <span class="required-mark">*</span>
                    </label>

                    <input asp-for="DesignName"
                           class="fi"
                           placeholder="Culvert at Ch. 89+450" />

                    <span asp-validation-for="DesignName"
                          class="field-validation">
                    </span>
                </div>


                <div class="fg">
                    <label asp-for="DesignCode">
                        Design Code
                    </label>

                    <input asp-for="DesignCode"
                           class="fi"
                           placeholder="NH48-CUL-001" />

                    <span asp-validation-for="DesignCode"
                          class="field-validation">
                    </span>
                </div>

            </div>


            <div class="form-row-2">

                <div class="fg">
                    <label asp-for="CulvertLocation">
                        Location
                    </label>

                    <input asp-for="CulvertLocation"
                           class="fi" />

                    <span asp-validation-for="CulvertLocation"
                          class="field-validation">
                    </span>
                </div>


                <div class="fg">
                    <label asp-for="Chainage">
                        Chainage
                    </label>

                    <input asp-for="Chainage"
                           class="fi"
                           placeholder="89+450" />

                    <span asp-validation-for="Chainage"
                          class="field-validation">
                    </span>
                </div>

            </div>


            <div class="fg">

                <label asp-for="CulvertType">
                    Culvert Type
                </label>

                <select asp-for="CulvertType"
                        class="fi">

                    <option value="SinglePipe">
                        Single Pipe
                    </option>

                    <option value="MultiplePipe">
                        Multiple Pipe
                    </option>

                    <option value="Box">
                        Box Culvert
                    </option>

                    <option value="Arch">
                        Arch Culvert
                    </option>

                </select>

                <span asp-validation-for="CulvertType"
                      class="field-validation">
                </span>

            </div>

        </div>


        <!-- =================================================
             Hydrological Design
             ================================================= -->

        <div class="form-section">

            <div class="form-section-header">
                <i class="bi bi-droplet" aria-hidden="true"></i>

                <div>
                    <h3>Hydrological Design</h3>
                    <p>Hydrological inputs used to determine design discharge.</p>
                </div>
            </div>


            <div class="info-pill">
                <i class="bi bi-info-circle" aria-hidden="true"></i>
                <span>
                    Rational Method: Q = C·I·A / 360 (IS SP 13 Cl.4)
                </span>
            </div>


            <div class="form-row-2">

                <div class="fg">
                    <label asp-for="CatchmentAreaHa">
                        Catchment Area (ha)
                    </label>

                    <input asp-for="CatchmentAreaHa"
                           type="number"
                           step="0.01"
                           class="fi" />

                    <span asp-validation-for="CatchmentAreaHa"
                          class="field-validation">
                    </span>
                </div>


                <div class="fg">
                    <label asp-for="RainfallIntensityMmHr">
                        Rainfall Intensity (mm/hr)
                    </label>

                    <input asp-for="RainfallIntensityMmHr"
                           type="number"
                           step="0.1"
                           class="fi"
                           placeholder="80" />

                    <span asp-validation-for="RainfallIntensityMmHr"
                          class="field-validation">
                    </span>
                </div>

            </div>


            <div class="form-row-2">

                <div class="fg">
                    <label asp-for="RunoffCoefficient">
                        Runoff Coefficient C
                    </label>

                    <input asp-for="RunoffCoefficient"
                           type="number"
                           step="0.01"
                           class="fi"
                           placeholder="0.55" />

                    <span asp-validation-for="RunoffCoefficient"
                          class="field-validation">
                    </span>
                </div>


                <div class="fg">
                    <label asp-for="DesignDischargeQ">
                        Design Discharge Q (override)
                    </label>

                    <input asp-for="DesignDischargeQ"
                           type="number"
                           step="0.001"
                           class="fi"
                           placeholder="Auto-calculated if blank" />

                    <span asp-validation-for="DesignDischargeQ"
                          class="field-validation">
                    </span>
                </div>

            </div>

        </div>


        <!-- =================================================
             Structural Parameters
             ================================================= -->

        <div class="form-section">

            <div class="form-section-header">
                <i class="bi bi-building" aria-hidden="true"></i>

                <div>
                    <h3>Structural Parameters</h3>
                    <p>Structural loading and site parameters.</p>
                </div>
            </div>


            <div class="info-pill">
                <i class="bi bi-info-circle" aria-hidden="true"></i>
                <span>
                    Earth load: Marston's Formula (IS 783 Cl.5.1)
                    · Live load: IS 783 Table 1
                </span>
            </div>


            <div class="form-row-2">

                <div class="fg">
                    <label asp-for="FillHeightM">
                        Fill Height H (m)
                    </label>

                    <input asp-for="FillHeightM"
                           type="number"
                           step="0.1"
                           class="fi" />

                    <span asp-validation-for="FillHeightM"
                          class="field-validation">
                    </span>
                </div>


                <div class="fg">
                    <label asp-for="RoadwayWidthM">
                        Roadway Width (m)
                    </label>

                    <input asp-for="RoadwayWidthM"
                           type="number"
                           step="0.5"
                           class="fi"
                           value="7.5" />

                    <span asp-validation-for="RoadwayWidthM"
                          class="field-validation">
                    </span>
                </div>

            </div>


            <div class="form-row-2">

                <div class="fg">
                    <label asp-for="SlopePercent">
                        Bed Slope (%)
                    </label>

                    <input asp-for="SlopePercent"
                           type="number"
                           step="0.1"
                           class="fi"
                           value="0.5" />

                    <span asp-validation-for="SlopePercent"
                          class="field-validation">
                    </span>
                </div>


                <div class="fg">
                    <label asp-for="SoilUnitWeightKNm3">
                        Soil Unit Weight (kN/m³)
                    </label>

                    <input asp-for="SoilUnitWeightKNm3"
                           type="number"
                           step="0.5"
                           class="fi"
                           value="18.5" />

                    <span asp-validation-for="SoilUnitWeightKNm3"
                          class="field-validation">
                    </span>
                </div>

            </div>


            <div class="fg">

                <label asp-for="SoilType">
                    Soil Type
                </label>

                <input asp-for="SoilType"
                       class="fi"
                       placeholder="Medium Clay" />

                <span asp-validation-for="SoilType"
                      class="field-validation">
                </span>

            </div>

        </div>


        <!-- =================================================
             Design Standards
             ================================================= -->

        <div class="form-section">

            <div class="form-section-header">
                <i class="bi bi-journal-text" aria-hidden="true"></i>

                <div>
                    <h3>Design Standards</h3>
                    <p>Codes and loading classification for this design.</p>
                </div>
            </div>


            <div class="fg">

                <label asp-for="DesignStandard">
                    Design Standard
                </label>

                <select asp-for="DesignStandard"
                        class="fi">

                    <option value="IRC 89:1997">
                        IRC 89:1997 — Road Culverts
                    </option>

                    <option value="IRC SP 13:2004">
                        IRC SP 13:2004 — Small Bridges
                    </option>

                </select>

                <span asp-validation-for="DesignStandard"
                      class="field-validation">
                </span>

            </div>


            <div class="fg">

                <label asp-for="LoadClass">
                    Loading Class
                </label>

                <select asp-for="LoadClass"
                        class="fi">

                    <option value="IRC_ClassA">
                        IRC Class A
                    </option>

                    <option value="IRC_ClassAA">
                        IRC Class AA
                    </option>

                    <option value="IRC_70R">
                        IRC 70R
                    </option>

                    <option value="IRC_ClassB">
                        IRC Class B
                    </option>

                </select>

                <span asp-validation-for="LoadClass"
                      class="field-validation">
                </span>

            </div>


            <div class="fg">

                <label asp-for="ChangeDescription">
                    Change Description
                </label>

                <input asp-for="ChangeDescription"
                       class="fi"
                       value="Initial Design (R0)" />

                <span asp-validation-for="ChangeDescription"
                      class="field-validation">
                </span>

            </div>

        </div>


        <!-- =================================================
             Form Actions
             ================================================= -->

        <div class="form-actions">

            <a asp-controller="Projects"
               asp-action="Details"
               asp-route-id="@ViewBag.ProjectId"
               class="btn-ghost">

                <i class="bi bi-x-lg" aria-hidden="true"></i>
                <span>Cancel</span>

            </a>


            <button type="submit"
                    class="btn-success">

                <i class="bi bi-calculator" aria-hidden="true"></i>
                <span>Create Design &amp; Calculate</span>

            </button>

        </div>

    </form>

</div>